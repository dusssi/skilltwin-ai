# ---------------------------------------------------------------------------
# SkillTwin AI environment configuration (copy to .env and fill in).
# NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- LLM (Google Gemini via HTTPS). Leave empty to use the honest local
# --- Twin-derived fallback composer instead of the AI model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_BASE=https://generativelanguage.googleapis.com
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_RETRIES=2
# LLM_TEMPERATURE=0.2
# LLM_MAX_OUTPUT_TOKENS=1024

# --- Database (SQLite file path) ---
# SKILLTWIN_DB_PATH=/data/skilltwin.db

# --- Uploads ---
# SKILLTWIN_UPLOAD_DIR=./uploads
# SKILLTWIN_MAX_UPLOAD_MB=5

# --- Auth ---
# SKILLTWIN_TOKEN_EXPIRE_HOURS=72
# SKILLTWIN_PASSWORD_MIN_LENGTH=8

# --- API security ---
# SKILLTWIN_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# SKILLTWIN_RATE_LIMIT_ENABLED=true
# SKILLTWIN_RATE_LIMIT_PER_MINUTE=120
# SKILLTWIN_RATE_LIMIT_SENSITIVE_PER_MINUTE=15

# --- RAG ---
# SKILLTWIN_RAG_THRESHOLD=0.12
# SKILLTWIN_RAG_TOP_K=3

# --- Frontend ---
# BACKEND_URL=http://127.0.0.1:8000
